# Indexing stays off on local and staging. Enable only on approved canonical deployment.
SITE_INDEXABLE=false
# All inquiry delivery settings are required; leave unset for honest unavailable mode.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
# HTTPS REST endpoint, not a raw Redis URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
